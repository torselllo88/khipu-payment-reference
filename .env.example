# --- Access control for the deployed demo ---
# password: gate the whole site behind a login screen
# open: no gate, anyone with the URL can view the demo
DEMO_ACCESS_MODE=open
DEMO_PASSWORD=changeme
AUTH_SECRET=please-change-this-to-a-long-random-string

# --- Provider modes ---
# stub: fully emulated responses, no network calls, no keys needed (default)
# live: real HTTP calls to the provider using the keys below
KHIPU_MODE=stub
UNLIMIT_MODE=stub

# --- Real credentials (only needed once *_MODE=live) ---
KHIPU_API_KEY=
KHIPU_SECRET=
# Unlimit v3 auth is OAuth client-credentials (terminal_code + password ->
# bearer token), not a flat API key — see lib/unlimit/client.ts.
UNLIMIT_TERMINAL_CODE=
UNLIMIT_PASSWORD=
